# Required for the voice conversation
DEEPGRAM_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Optional provider tuning
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_TTS_VOICE=aura-2-helena-en
DEEPGRAM_TTS_MODEL=

# Feedback analysis
FEEDBACK_LLM_MODEL=
FEEDBACK_TIMEOUT_SECONDS=45
FEEDBACK_MAX_ATTEMPTS=2

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WebRTC connectivity (required when the backend has no public UDP, e.g. Render)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
SESSION_MAX_SECONDS=300
SESSION_TIME_WARNING_SECONDS=60
SESSION_TTL_SECONDS=3600
SESSION_RATE_LIMIT_PER_MINUTE=10
